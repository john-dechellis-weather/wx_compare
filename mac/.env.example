# Copy to mac/.env and fill in from Render -> your service -> Environment.
# mac/run_bluemet.sh sources this file; launchd passes nothing else.
# NEVER commit mac/.env (it is in .gitignore).
#
# Required - without it every visitor sees "Site is not configured
# with a password":
APP_PASSWORD=
#
# Fleet warmer / login map / CONUS map aircraft (ADS-B via OpenSky):
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
#
# Copy any others Render has, e.g.:
# WIDE_DECIM=
# CARTOPY_DATA_DIR=
# AGUACERO_VIZ_KEY=
#
# tomorrow.io: ONE running instance may hold the key (two double the
# spend). Leave this empty while Render serves bluemet.org; fill it in
# when the Mac takes over and remove it from Render at the same time.
# TOMORROWIO_API_KEY=
#
# AirNav RadarBox On Demand API (11 Oct): JBU arrivals pod on Station
# Forecast. Per-result pricing; core/radarbox.py caps the month at
# RBX_MONTH_CAP (default 9000) and caches each station 3 h.
# RADARBOX_TOKEN=
